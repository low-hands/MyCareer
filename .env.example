# Orchestrator agent (main agent for CLI chat)
ORCHESTRATOR_MODEL=gpt-4o
ORCHESTRATOR_API_KEY=sk-your-key-here
ORCHESTRATOR_BASE_URL=https://api.openai.com/v1

# Resume parser (may reuse the same provider/model as the orchestrator)
RESUME_MODEL=gpt-4o
RESUME_API_KEY=sk-your-key-here
RESUME_BASE_URL=https://api.openai.com/v1

# Local persistence. One shared database is partitioned by tenant_id.
CAREER_AGENT_TENANT_ID=local
CAREER_AGENT_DATA_DIR=~/.career-agent

# boss-agent-cli (job search MCP server)
# Login required: run `boss login` to authenticate with Boss Zhipin
# No API key needed — boss-agent-cli uses your Boss直聘 login session

# Future agent roles (uncomment when needed):
# RESEARCHER_MODEL=gpt-3.5-turbo
# RESEARCHER_API_KEY=sk-your-key-here
# RESEARCHER_BASE_URL=https://api.openai.com/v1
