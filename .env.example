# Current Alibaba Cloud Token Plan OpenAI-compatible endpoint. May be a full /chat/completions URL or its v1 base URL.
PLANNER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions

# Use a newly generated key. Never commit this value.
PLANNER_API_KEY=

# Main Agent configuration. This controls natural-language conversation and workflow tool selection.
MAIN_AGENT_BASE_URL=https://api.example.com/v1/chat/completions
MAIN_AGENT_API_KEY=
MAIN_AGENT_MODEL=
# Input-token capacity used by whole-request compaction pressure accounting.
MAIN_AGENT_MAX_INPUT_TOKENS=32000
# Prompt-cache request policy: implicit sends a stable cache key; explicit also
# requests provider-supported breakpoints. No hostname/model guessing is used.
MAIN_AGENT_PROMPT_CACHE=implicit
# Calibrate the fallback/token-packing estimator to the externally configured
# tokenizer. 1.8 is conservative for GPT/Claude-style CJK BPE; Qwen/DeepSeek
# deployments should measure and lower it (often near 1.0-1.1).
MAIN_AGENT_CJK_TOKENS_PER_CHAR=1.8
MAIN_AGENT_ASCII_CHARS_PER_TOKEN=4.0
# Conservative correction for tokenizer-envelope overhead observed from the
# provider. Set to 1.0 only after measuring that this provider needs no margin.
MAIN_AGENT_INPUT_TOKEN_SAFETY_FACTOR=1.1
