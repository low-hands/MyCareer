# Current Alibaba Cloud Token Plan OpenAI-compatible endpoint. May be a full /chat/completions URL or its v1 base URL.
PLANNER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions

# Use a newly generated key. Never commit this value.
PLANNER_API_KEY=

# Main Agent configuration. This controls natural-language conversation and workflow tool selection.
# Keep it separate from Job Discovery's internal worker configuration below.
MAIN_AGENT_BASE_URL=https://api.example.com/v1/chat/completions
MAIN_AGENT_API_KEY=
MAIN_AGENT_MODEL=

# Current DashScope deployment model. Change this without code changes to use another compatible model.
# Job Discovery's private Agent worker configuration.
JOB_DISCOVERY_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
JOB_DISCOVERY_AGENT_API_KEY=
JOB_DISCOVERY_AGENT_MODEL=qwen3.6-plus
