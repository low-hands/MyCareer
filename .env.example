# Current Alibaba Cloud Token Plan OpenAI-compatible endpoint. May be a full /chat/completions URL or its v1 base URL.
PLANNER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions

# Use a newly generated key. Never commit this value.
PLANNER_API_KEY=

# Main Agent configuration. This controls natural-language conversation and workflow tool selection.
MAIN_AGENT_BASE_URL=https://api.example.com/v1/chat/completions
MAIN_AGENT_API_KEY=
MAIN_AGENT_MODEL=
