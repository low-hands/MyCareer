# Main Agent configuration. This controls natural-language conversation and workflow tool selection.
MAIN_AGENT_BASE_URL=https://api.example.com/v1/chat/completions
MAIN_AGENT_API_KEY=
MAIN_AGENT_MODEL=
# Model-provider request timeout. 120 seconds is recommended for the current
# local deployment; transient 429/502/503/504 responses use bounded retries.
MAIN_AGENT_TIMEOUT_SECONDS=120
# Input-token capacity used by whole-request compaction pressure accounting.
MAIN_AGENT_MAX_INPUT_TOKENS=32000
# Completion budget for one decision (tool choice and final answer share it,
# reasoning tokens included). A decision that hits it fails closed as
# MAIN_AGENT_RESPONSE_TRUNCATED; nothing partial is shown. Minimum 256. An
# 8000-char answer is 8-9k tokens before reasoning. Input + output must fit
# the model's context window (32000 + 16384 assumes at least 64k).
MAIN_AGENT_MAX_OUTPUT_TOKENS=16384
# Operator-declared provider context window, not inferred from model/hostname.
# Startup rejects input + output above this limit. Set the actual model limit.
MAIN_AGENT_CONTEXT_WINDOW_TOKENS=65536
# Prompt-cache request policy: implicit sends a stable cache key; explicit also
# requests provider-supported breakpoints. No hostname/model guessing is used.
MAIN_AGENT_PROMPT_CACHE=implicit

# Conversation compaction: complete-request occupancy remains 75%, with
# projection_overflow protecting contiguous history before old rows disappear.
# Bounds: recent 2..64, batch 2..32, occupancy 0.7..0.9 (inclusive).
CONTEXT_RECENT_MESSAGE_LIMIT=16
CONTEXT_SUMMARY_BATCH_SIZE=8
CONTEXT_COMPACT_OCCUPANCY_THRESHOLD=0.75

# Optional independent summary model: Chat Completions JSON Schema required.
# Leave the connection group UNSET to reuse Main endpoint/key/model/input
# capacity with a separate 30s timeout and 1200 output tokens. DISABLE_THINKING
# may be set alone on that fallback; other partial/blank groups fail startup.
# Neither invalid config nor provider failures silently fall back.
# Uncomment and fill all three connection fields to select a summary model.
# CONVERSATION_SUMMARY_AGENT_BASE_URL=https://api.example.com/v1
# CONVERSATION_SUMMARY_AGENT_API_KEY=
# CONVERSATION_SUMMARY_AGENT_MODEL=
# CONVERSATION_SUMMARY_AGENT_TIMEOUT_SECONDS=30
# CONVERSATION_SUMMARY_AGENT_MAX_INPUT_TOKENS=32000
# CONVERSATION_SUMMARY_AGENT_MAX_OUTPUT_TOKENS=1200
# CONVERSATION_SUMMARY_AGENT_CONTEXT_WINDOW_TOKENS=65536
# Bailian-only explicit request option. Do not enable it for an endpoint that
# does not accept enable_thinking; an unsupported parameter fails closed.
# CONVERSATION_SUMMARY_AGENT_DISABLE_THINKING=true
# Bounds: timeout 1..120s, input 1024..2000000, output 256..16384,
# context window 2048..2000000; input + output must fit the actual model.

# Specialist-agent configuration. The current runtime reuses this group for
# resume analysis and matching, resume tailoring/review, job research, email
# classification, interview preparation, and mock interviews. It may point to
# the same OpenAI-compatible endpoint/model as MAIN_AGENT_*.
RESUME_ANALYSIS_AGENT_BASE_URL=https://api.example.com/v1/chat/completions
RESUME_ANALYSIS_AGENT_API_KEY=
RESUME_ANALYSIS_AGENT_MODEL=

# Optional independent job-research (company research) endpoint. Leave the whole
# group unset to reuse RESUME_ANALYSIS_AGENT_*. Setting any one requires all of
# URL/key/model; the provider must accept the native Responses web_search tool.
# Run python -m career_agent.agent.job_research_provider_smoke before relying on it.
# JOB_RESEARCH_AGENT_BASE_URL=https://api.example.com/v1
# JOB_RESEARCH_AGENT_API_KEY=
# JOB_RESEARCH_AGENT_MODEL=
# JOB_RESEARCH_AGENT_TIMEOUT_SECONDS=30

# Optional semantic retrieval for confirmed career evidence. Leave all three
# unset to keep the local lexical-only path. This endpoint must implement the
# OpenAI-compatible /embeddings API; vectors are cached as derived local data.
# CAREER_EMBEDDING_BASE_URL=https://api.example.com/v1
# CAREER_EMBEDDING_API_KEY=
# CAREER_EMBEDDING_MODEL=
# CAREER_EMBEDDING_BATCH_SIZE=64

# Packing and request occupancy use tiktoken cl100k_base. The model is an
# external alias, so this does not sniff a hostname or model name for an encoding.
# Vocab ships in the package cache (URL-sha1 filenames). Set this only to
# override that location; an empty or missing dir will make tiktoken fetch.
# TIKTOKEN_CACHE_DIR=
