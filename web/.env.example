# Local first-party web credential, held by the Vite proxy rather than bundled
# into browser JavaScript. Issue it with:
# career-agent api-keys issue --user-id USER --name web \
#   --scope workspace:read --scope workspace:write --scope chat:write
CAREER_AGENT_WEB_API_KEY=

# Separate weak-storage credential synchronized to the browser extension.
# It should carry capture:write and no workspace read or chat scopes.
VITE_CAPTURE_API_KEY=

# Usually left as /api so Vite's loopback proxy is used.
VITE_API_BASE_URL=/api

# Backend-only Google OAuth configuration (normally stored in the root .env).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/v1/connections/google/callback
# CAREER_AGENT_WEB_URL=http://127.0.0.1:5173
