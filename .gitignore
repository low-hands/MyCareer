# Local Career Agent working documents
/docs/
/papers/

# Local runtime secrets
.env
/web/.env

# Local and Python-generated files
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
/papers/pdf/*.pdf
/.cursor/

# React client build output
/node_modules/
/web/node_modules/
/web/dist/
/web/.vite/

# Credential and workspace databases. api_keys.sqlite3 holds live API key
# digests: committing it would put the credential store in every clone and in
# every history rewrite, and a digest that has been published is a credential
# that has to be reissued.
data/
*.sqlite3

# tiktoken vocab is filled at install/build, not committed.
src/career_agent/agent/_static/tiktoken_cache/*
!src/career_agent/agent/_static/tiktoken_cache/.gitignore

# Claude Code per-machine permissions
.claude/

# Live smoke artifacts (README points --work-root here); reports contain no content
/output/
